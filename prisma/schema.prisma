generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum BloodGroup {
  A_POS
A_NEG
B_POS
B_NEG
AB_POS
AB_NEG
O_POS
O_NEG
}

model User {
  id             Int        @id @default(autoincrement())
  name           String
  dob            DateTime
  mobile         String     @unique
  email          String     @unique
  bloodGroup     BloodGroup
  privacyConsent Boolean
  posts          Post[]
  comments       Comment[]
}

model Post {
  id            Int              @id @default(autoincrement())
  userId        Int
  user          User             @relation(fields: [userId], references: [id])
  title         String
  description   String
  mobile        String
  datePosted    DateTime         @default(now())
  expiryTime    DateTime
  bloodRequired PostBloodGroup[]
  comments      Comment[]
}

model PostBloodGroup {
  id         Int        @id @default(autoincrement())
  postId     Int
  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  bloodGroup BloodGroup
}

model Comment {
  id          Int      @id @default(autoincrement())
  postId      Int
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  description String
  datePosted  DateTime @default(now())
}


model Otp {
  id         Int      @id @default(autoincrement())
  identifier String
  code       String
  expiresAt  DateTime
  verified   Boolean  @default(false)
}